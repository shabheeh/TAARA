  <script src="/Admin/assets/js/main.js"></script>
  
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> 

  <script>
     


    // Function to show confirmation modal
    function showConfirmationModal(userId) {
        $('#confirmationModal').modal('show');
        $('#confirmationModal').data('userId', userId);
    }

    // Function to confirm block/unblock action
    function confirmAction() {
        const userId = $('#confirmationModal').data('userId');
        const action = $('#confirmationModal').data('action');

        if (action === 'Block') {
            blockUser(userId);
        } else if (action === 'Unblock') {
            unblockUser(userId);
        }

        $('#confirmationModal').modal('hide');
    }

    // Function to handle block user request
    function blockUser(userId) {
        fetch(`/admin/blockUser`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ userId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.isBlocked) {
                
                $(`a[data-user-id="${userId}"]`).removeClass('bg-label-danger').addClass('bg-label-success').text('Unblock');
                // Update counts
                document.getElementById('activeUsersCount').innerText = data.activeUsersCount;
                document.getElementById('blockedUsersCount').innerText = data.blockedUsersCount;
      
            } else {
           
                // Show error alert
                Swal.fire({
                                title: 'Error',
                                text: data.message,
                                icon: 'error',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'OK'
                            });
            }
        })
        .catch(error => console.error('Error blocking user:', error));
        // Show error alert
        Swal.fire({
                                title: 'Error',
                                text: error.message,
                                icon: 'error',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'OK'
                            });
    }

    // Function to handle unblock user request
    function unblockUser(userId) {
        fetch(`/admin/unblockUser`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ userId })
        })
        .then(response => response.json())
        .then(data => {
            if (!data.isBlocked) {
                
                $(`a[data-user-id="${userId}"]`).removeClass('bg-label-success').addClass('bg-label-danger').text('Block');
                // Update counts
                document.getElementById('activeUsersCount').innerText = data.activeUsersCount;
                document.getElementById('blockedUsersCount').innerText = data.blockedUsersCount;
                
            } else {
                // Show error alert
                Swal.fire({
                  title: 'Error',
                  text: data.message,
                  icon: 'error',
                  confirmButtonColor: '#d33',
                  confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => console.error('Error unblocking user:', error));
        // Show error alert
        Swal.fire({
          title: 'Error',
          text: error.message,
          icon: 'error',
          confirmButtonColor: '#d33',
          confirmButtonText: 'OK'
        });
    }

    // Event listener blockbutton
    $(document).ready(function() {
        $('.blockButton').click(function(event) {
            event.preventDefault();
            const userId = $(this).data('user-id');
            const action = $(this).text()

            $('#confirmationModal').data('action', action);
            showConfirmationModal(userId);
        });
    });
  </script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('userSearch');
    const statusFilter = document.getElementById('statusFilter');
    const orderFilter = document.getElementById('orderFilter');
    const joinedFrom = document.getElementById('joinedFrom');
    const joinedTo = document.getElementById('joinedTo');
    const applyDateBtn = document.getElementById('applyDateFilter');

    function performSearch(includeDate = false) {
      const searchTerm = searchInput.value.trim();
      const status = statusFilter.value;
      const order = orderFilter.value;
      const fromDate = joinedFrom.value;
      const toDate = joinedTo.value;

      const params = new URLSearchParams();

      if (searchTerm) params.append('search', searchTerm);
      if (status) params.append('status', status);
      if (order) params.append('orderFilter', order);

      if (includeDate) {
        if (fromDate) params.append('from', fromDate);
        if (toDate) params.append('to', toDate);
      }

      const queryString = params.toString();
      const url = queryString ? `/admin/users?${queryString}` : '/admin/users';
      window.location.href = url;
    }

    searchInput.addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        performSearch(false);
      }
    });

    statusFilter.addEventListener('change', () => performSearch(false));
    orderFilter.addEventListener('change', () => performSearch(false));

  
    applyDateBtn.addEventListener('click', () => performSearch(true));
  });
</script>



  
