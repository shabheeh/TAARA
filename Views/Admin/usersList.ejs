 <!-- Content wrapper -->
 <div class="content-wrapper">

    <!-- Content -->
    
    <div class="flex-grow-1 container-p-y container-fluid">
            
            

        <div class="row g-6 mb-6">
          <div class="col-sm-6 col-xl-3">
            <div class="card">
              <div class="card-body">
                <div class="d-flex justify-content-between">
                  <div class="me-1">
                    <p class="text-heading mb-1">Total Users</p>
                    <div class="d-flex align-items-center">
                      <h4 class="mb-1 me-2"><%= totalUsers %></h4>
                      <!-- <p class="text-success mb-1">(+29%)</p> -->
                    </div>
                    <!-- <small class="mb-0">Total Users</small> -->
                  </div>
                  <div class="avatar">
                    <div class="avatar-initial bg-label-primary rounded">
                      <div class="ri-group-line ri-26px"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="card">
              <div class="card-body">
                <div class="d-flex justify-content-between">
                  <div class="me-1">
                    <p class="text-heading mb-1">Active Users</p>
                    <div class="d-flex align-items-center">
                      <h4 class="mb-1 me-2" id="activeUsersCount"><%= activeUsersCount %></h4>
                    </div>
                  </div>
                  <div class="avatar">
                    <div class="avatar-initial bg-label-success rounded">
                      <div class="ri-user-follow-line ri-26px"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="card">
              <div class="card-body">
                <div class="d-flex justify-content-between">
                  <div class="me-1">
                    <p class="text-heading mb-1">Blocked Users</p>
                    <div class="d-flex align-items-center">
                      <h4 class="mb-1 me-2" id="blockedUsersCount"><%= blockedUsersCount %></h4>
                      <!-- <p class="text-success mb-1">(+18%)</p> -->
                    </div>
                    <!-- <small class="mb-0">Last week analytics</small> -->
                  </div>
                  <div class="avatar">
                    <div class="avatar-initial bg-label-danger rounded">
                      <div class="ri-user-forbid-line ri-26px scaleX-n1"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
        <!-- Users List Table -->
        <!-- usersList.ejs or usersList.html -->
        <div class="card">
          <div class="card-datatable table-responsive">
            <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
              <!-- Row 1: Filters -->
<div class="row mx-1 mt-4 mb-2">
  <!-- Blocked/Unblocked Filter -->
  <div class="col-md-2 mb-2">
    <label for="statusFilter" class="form-label">Status</label>
    <select id="statusFilter" class="form-select form-select-sm">
      <option value="">All</option>
      <option value="true" <% if (status === 'true') { %> selected <% } %>>Blocked</option>
      <option value="false" <% if (status === 'false') { %> selected <% } %>>Unblocked</option>
    </select>
  </div>

  <!-- Order Count Filter -->
  <div class="col-md-2 mb-2">
    <label for="orderFilter" class="form-label">Orders</label>
    <select id="orderFilter" class="form-select form-select-sm">
      <option value="">All Orders</option>
      <option value="lt5" <% if (orderFilter === 'lt5') { %> selected <% } %>>< 5 Orders</option>
      <option value="5to10" <% if (orderFilter === '5to10') { %> selected <% } %>>5 – 10 Orders</option>
      <option value="gt10" <% if (orderFilter === 'gt10') { %> selected <% } %>>10+ Orders</option>
    </select>
  </div>

  <!-- Joined Date From -->
  <div class="col-md-3 mb-2">
    <label for="joinedFrom" class="form-label">Joined From</label>
    <input type="date" id="joinedFrom" class="form-control form-control-sm"
           value="<%= from || '' %>">
  </div>

  <!-- Joined Date To -->
  <div class="col-md-3 mb-2">
    <label for="joinedTo" class="form-label">Joined To</label>
    <input type="date" id="joinedTo" class="form-control form-control-sm"
           value="<%= to || '' %>">
  </div>

  

  <!-- Apply Button -->
  <div class="col-md-1 mb-2 d-grid">
    <label class="form-label invisible">Apply</label>
    <button class="btn btn-primary btn-sm" style="min-width: 160px;" id="applyDateFilter">Apply</button>
  </div>
</div>

<!-- Row 2: Show Limit and Search -->
<div class="row mx-1 align-items-end justify-content-between">
  <!-- Show Limit Dropdown -->


  <!-- Search -->
  <div class="col-md-4 mb-2">
    <label for="userSearch" class="form-label">Search</label>
    <input type="text" id="userSearch" class="form-control form-control-sm"
           value="<%= locals.searchTerm ? searchTerm : '' %>"
           placeholder="Search by name or email">
  </div>

    <div class="col-md-2 mb-2">
    <label class="form-label">Show</label>
    <select class="form-select form-select-sm"
            onchange="window.location.href='?page=<%= page %>&limit=' + this.value">
      <option value="10" <% if (limit == 10) { %> selected <% } %>>10</option>
      <option value="25" <% if (limit == 25) { %> selected <% } %>>25</option>
      <option value="50" <% if (limit == 50) { %> selected <% } %>>50</option>
      <option value="100" <% if (limit == 100) { %> selected <% } %>>100</option>
    </select>
  </div>
</div>


              <table class="datatables-users table dataTable no-footer dtr-column" id="DataTables_Table_0"
                aria-describedby="DataTables_Table_0_info">
                <thead>
                  <tr>
                    <th>SI</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Date Of Joined</th>
                    <th>Orders</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (users.length> 0) { %>
                    <% users.forEach((user, index)=> { %>
                      <tr>
                        <td>
                          <%= (page - 1) * limit + index + 1 %>
                        </td>
                        <td>
                          <div class="d-flex justify-content-start align-items-center user-name">
                            <div class="avatar-wrapper">
                              <div class="avatar avatar-sm me-4">
                                <img src="/Admin/assets/img/avatars/2.png" alt="Avatar" class="rounded-circle">
                              </div>
                            </div>
                            <div class="d-flex flex-column">
                              <a  class="text-heading text-truncate">
                                <span class="fw-medium">
                                  <%= user.firstName ? user.firstName : 'First Name' %>
                                </span>
                              </a>
                              <small>
                                <%= user.lastName ? user.lastName : 'Last Name' %>
                              </small>
                            </div>
                          </div>
                        </td>
                        <td>
                          <%= user.email %>
                        </td>
                        <td>
                          <%= new Date(user.createdAt).toLocaleDateString('en-IN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        }) %>

                        </td>
                        <td>
                          <%= user.orders.length %>
                        </td>
                        <td>
                          <% if (!user.isBlocked) { %>
                            <a href="#" class="badge rounded-pill bg-label-danger blockButton"
                              data-user-id="<%= user._id %>">Block</a>
                            <% } else { %>
                              <a href="#" class="badge rounded-pill bg-label-success blockButton"
                                data-user-id="<%= user._id %>">Unblock</a>
                              <% } %>
                        </td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="6">No users found.</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
              <div class="row mx-1">
                <div class="col-sm-12 col-md-6">
                  <div class="dataTables_info" id="DataTables_Table_0_info" role="status" aria-live="polite">
                    Showing <%= (page - 1) * limit + 1 %> to <%= Math.min(page * limit, totalUsers) %> of <%= totalUsers %>
                          entries
                  </div>
                </div>
                <div class="col-sm-12 col-md-6">
                  <div class="dataTables_paginate paging_simple_numbers" id="DataTables_Table_0_paginate">
                    <ul class="pagination">
                      <li class="paginate_button page-item previous <%= page === 1 ? 'disabled' : '' %>">
                        <a href="?page=<%= page - 1 %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>"
                          class="page-link">Previous</a>
                      </li>
                      <% for (let i=1; i <=totalPages; i++) { %>
                        <li class="paginate_button page-item <%= i === page ? 'active' : '' %>">
                          <a href="?page=<%= i %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>"
                            class="page-link">
                            <%= i %>
                          </a>
                        </li>
                        <% } %>
                          <li class="paginate_button page-item next <%= page === totalPages ? 'disabled' : '' %>">
                            <a href="?page=<%= page + 1 %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>"
                              class="page-link">Next</a>
                          </li>
                    </ul>
                  </div>
              
                </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        

          <!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
  <div class="modal-dialog">
      <div class="modal-content">
          <div class="modal-header">
              <h5 class="modal-title" id="confirmationModalLabel">Confirm Action</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
              Are you sure you want to perform this action?
          </div>
          <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-primary" onclick="confirmAction()">Confirm</button>
          </div>
      </div>
  </div>
</div>
        
                  </div>
      <!-- / Content -->

      

